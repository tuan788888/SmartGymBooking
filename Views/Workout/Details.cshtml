@model SmartGymBooking.Models.WorkoutPlan

@{
    ViewData["Title"] = "Chi tiết giáo án";

    var days = Model.WorkoutExercises
        .GroupBy(x => x.DayNumber)
        .OrderBy(x => x.Key);
}


<div class="mb-4">

    <a asp-action="Index"
       class="text-decoration-none">

        ← Giáo án của tôi

    </a>

    <h2 class="page-title mt-3">
        @Model.Title
    </h2>

    <partial name="_DeletePlan" model="Model.WorkoutPlanId" />


    @if (!string.IsNullOrWhiteSpace(
        Model.PredictedPlanType))
    {
        <span class="badge bg-success">
            @Model.PredictedPlanType
        </span>
    }

</div>


@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}

@foreach (var day in days)
{
    <div class="smart-card mb-4">

        <div class="card-header">

            <h4>
                Ngày @day.Key
            </h4>

        </div>


        <div class="card-body">

            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>

                        <tr>
                            <th>Bài tập</th>
                            <th>Nhóm cơ</th>
                            <th>Sets</th>
                            <th>Reps</th>
                            <th>Nghỉ</th>
                            <th>Hướng dẫn</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in day.OrderBy(x => x.OrderNumber).ThenBy(x => x.WorkoutExerciseId))
                        {
                            var prescription = item.Prescription;
                            <tr>

                                <td>

                                    <strong>
                                        @item.Exercise.Name
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(
                                        prescription.Note))
                                    {
                                        <div class="small text-muted">
                                            @prescription.Note
                                        </div>
                                    }

                                </td>


                                <td>
                                    @item.Exercise.MuscleGroup
                                </td>


                                <td>
                                    @prescription.Sets
                                </td>


                                <td>
                                    @prescription.Reps
                                </td>


                                <td>

                                    @if (item.RestSeconds != null)
                                    {
                                        <span>
                                            @item.RestSeconds giây
                                        </span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }

                                </td>


                                <td>

                                    <partial name="_ExerciseGuide" model='@(new SmartGymBooking.ViewModels.ExerciseGuideViewModel(
                                        item.Exercise.Name,
                                        string.IsNullOrWhiteSpace(item.Exercise.Instructions) ? item.Exercise.Description : item.Exercise.Instructions,
                                        item.Exercise.VideoUrl))' />
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
}
