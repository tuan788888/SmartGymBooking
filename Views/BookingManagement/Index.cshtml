@model IEnumerable<SmartGymBooking.Models.Booking>

@{
    ViewData["Title"] = "Lịch đặt của khách hàng";
    var canAssignPt = (HashSet<long>)ViewBag.CanAssignPt;
}

<div class="mb-4">

    <h2 class="page-title">
        Lịch đặt của khách hàng
    </h2>

    <p class="page-subtitle">
        Theo dõi lịch đặt, phân PT và ghi nhận khách đến tập.
    </p>

    <div class="d-flex gap-2 flex-wrap">
        <a asp-controller="CheckInManagement" asp-action="Create" class="btn btn-outline-primary">Ghi nhận khách đến tập</a>
        <a asp-controller="CheckInManagement" asp-action="Index" class="btn btn-outline-secondary">Lịch sử check-in</a>
    </div>
</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}


<div class="smart-card mb-4">

    <div class="card-body">

        <form method="get"
              class="row g-2">
            <input type="hidden" name="customerId" value="@ViewBag.CustomerId" />

            <div class="col-md-4">

                <select name="status"
                        class="form-select">

                    <option value="">
                        Tất cả
                    </option>

                    <option value="PENDING" selected="@(ViewBag.Status == "PENDING")">
                        PENDING
                    </option>

                    <option value="CONFIRMED" selected="@(ViewBag.Status == "CONFIRMED")">
                        CONFIRMED
                    </option>

                    <option value="COMPLETED" selected="@(ViewBag.Status == "COMPLETED")">
                        COMPLETED
                    </option>

                    <option value="CANCELLED" selected="@(ViewBag.Status == "CANCELLED")">
                        CANCELLED
                    </option>

                </select>

            </div>


            <div class="col-auto">

                <button type="submit"
                        class="btn btn-smart-primary">

                    Lọc

                </button>

            </div>

        </form>

    </div>

</div>


<div class="table-shell">

    <div class="table-responsive">

        <table class="table align-middle">

            <thead>

                <tr>
                    <th>Khách hàng</th>
                    <th>Dịch vụ</th>
                    <th>Bắt đầu</th>
                    <th>Kết thúc</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>

            </thead>


            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Không có booking phù hợp.</td></tr>
                }

                @foreach (var booking in Model)
                {
                    <tr>

                        <td>

                            @booking.Customer.FullName

                            <div class="small text-muted">
                                @booking.Customer.User.Email
                            </div>

                        </td>

                        <td>
                            @booking.Service.Name
                        </td>

                        <td>
                            @booking.StartTime.ToString(
                                "dd/MM/yyyy HH:mm"
                            )
                        </td>

                        <td>
                            @booking.EndTime.ToString(
                                "dd/MM/yyyy HH:mm"
                            )
                        </td>

                        <td>
                            <span class="badge @(booking.Status switch { "COMPLETED" => "bg-success", "PENDING" => "bg-warning text-dark", "CONFIRMED" => "bg-primary", _ => "bg-secondary" })">@(booking.Status switch { "COMPLETED" => "Hoàn thành", "PENDING" => "Chờ xác nhận", "CONFIRMED" => "Đã xác nhận", "CANCELLED" => "Đã hủy", _ => booking.Status })</span>
                        </td>


                        <td>

                            <div class="d-flex gap-2 flex-wrap">
                                @if (booking.Status != "CANCELLED" && booking.Ptschedules.FirstOrDefault() is { } ptSchedule)
                                {
                                    <span class="badge bg-info text-dark align-self-center">PT: @ptSchedule.Pt.FullName</span>
                                }
                                else if (canAssignPt.Contains(booking.BookingId))
                                {
                                    <a asp-controller="PTScheduleManagement" asp-action="Create" asp-route-bookingId="@booking.BookingId" class="btn btn-sm btn-outline-primary">Phân PT</a>
                                }

                                @if (booking.Status == "PENDING" && booking.StartTime > SmartGymBooking.Services.GymTime.Now)
                                {
                                    <form asp-action="Confirm"
                                          asp-route-id="@booking.BookingId"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button class="btn btn-sm btn-success">
                                            Xác nhận
                                        </button>

                                    </form>
                                }


                                @if (booking.Status == "CONFIRMED" && booking.CheckIn != null && booking.EndTime <= SmartGymBooking.Services.GymTime.Now)
                                {
                                    <form asp-action="Complete"
                                          asp-route-id="@booking.BookingId"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button class="btn btn-sm btn-primary">
                                            Hoàn thành
                                        </button>

                                    </form>
                                }


                                @if (
                                    booking.CheckIn == null &&
                                    booking.Status != "COMPLETED" &&
                                    booking.Status != "CANCELLED")
                                {
                                    <form asp-action="Cancel"
                                          asp-route-id="@booking.BookingId"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button class="btn btn-sm btn-outline-danger">
                                            Hủy
                                        </button>

                                    </form>
                                }

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
