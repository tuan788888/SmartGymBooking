@model IEnumerable<SmartGymBooking.ViewModels.PackageOption>

@{
    ViewData["Title"] = "Gói tập";
}

<div class="text-center mb-5">

    <h1 class="page-title">
        Chọn gói tập phù hợp
    </h1>

    <p class="page-subtitle">
        Bắt đầu hành trình tập luyện tại SmartGym
    </p>

</div>


<div class="row g-4 justify-content-center">

    @if (!Model.Any())
    {
        <div class="col-12 text-center text-muted">Hiện chưa có gói tập đang hoạt động.</div>
    }

    @if (TempData["ErrorMessage"] is string purchaseError)
    {
        <div class="col-12"><div class="alert alert-warning" role="alert">@purchaseError</div></div>
    }
    @foreach (var option in Model)
    {
        var package = option.Package;
        var upgrade = option.Quote.UpgradeFrom != null;
        <div class="col-lg-4 col-md-6">

            <div class="smart-card h-100">

                <div class="card-body p-4">

                    @if (package.IncludesPt)
                    {
                        <span class="badge bg-success mb-3">
                            Có Personal Trainer
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary mb-3">
                            @(BuildFeatures.AIEnabled ? "AI Virtual PT" : "Tập luyện tự do")
                        </span>
                    }


                    <h3>
                        @package.Name
                    </h3>


                    <h2 class="fw-bold my-3">

                        @((upgrade ? option.Quote.Amount : package.Price).ToString("#,0.##"))

                        <small class="fs-6 text-muted">
                            đ
                        </small>

                    </h2>


                    <p class="text-muted">
                        @package.DurationDays ngày
                    </p>


                    <p>
                        @package.Description
                    </p>


                    @if (User.IsInRole("CUSTOMER"))
                    {
                        @if (option.Quote.Error is string reason)
                        {
                            <p class="text-muted small mb-0">@reason</p>
                        }
                        else
                        {
                            @if (upgrade)
                            {
                                <p class="small">Giảm @(SmartGymBooking.Services.PackagePurchase.UpgradeDiscountPercent)% từ @package.Price.ToString("#,0.##") đ. Gói PT có hiệu lực đến @option.Quote.EndDate.ToString("dd/MM/yyyy HH:mm").</p>
                            }
                            <form asp-controller="Payment" asp-action="Create" method="post" class="mt-3">
                                <input type="hidden" name="packageId" value="@package.PackageId" />
                                <button type="submit" class="btn btn-smart-success w-100">@(upgrade ? "Nâng cấp gói PT" : "Chọn gói")</button>
                            </form>
                        }
                    }
                    else if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-controller="Auth"
                           asp-action="Login"
                           class="btn btn-smart-primary w-100 mt-3">

                            Đăng nhập để mua

                        </a>
                    }

                </div>

            </div>

        </div>
    }

</div>
