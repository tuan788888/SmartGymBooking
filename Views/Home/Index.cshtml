@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container">

    <div class="row align-items-center py-5">

        <div class="col-lg-6">

            <h1 class="display-4 fw-bold">

                SmartGym Booking

            </h1>

            <p class="lead mt-3">

                Hệ thống đặt lịch và quản lý phòng tập
                tích hợp trợ lý AI PT ảo.

            </p>


            @if (User.Identity?.IsAuthenticated != true)
            {
                <div class="mt-4">

                    <a asp-controller="Auth"
                       asp-action="Register"
                       class="btn btn-dark btn-lg me-2">

                        Đăng ký

                    </a>


                    <a asp-controller="Auth"
                       asp-action="Login"
                       class="btn btn-outline-dark btn-lg">

                        Đăng nhập

                    </a>

                </div>
            }


            @if (User.IsInRole("CUSTOMER"))
            {
                <div class="alert alert-success mt-4">

                    Xin chào
                    <strong>@User.Identity?.Name</strong>

                </div>
            }

        </div>


        <div class="col-lg-6 text-center">

            <div class="border rounded p-5 bg-light">

                <h3>SmartGym</h3>

                <p class="mb-0">

                    Booking • PT • Workout • AI

                </p>

            </div>

        </div>

    </div>

</div>
