@model SmartGymBooking.Models.Employee
@{
    ViewData["Title"] = "Chi tiết nhân viên";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div><h1 class="page-title">@Model.FullName</h1><p class="page-subtitle mb-0">Nhân viên #@Model.EmployeeId</p></div>
    <div class="d-flex gap-2"><a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a><a asp-action="Edit" asp-route-id="@Model.EmployeeId" class="btn btn-smart-primary">Sửa thông tin</a></div>
</div>
<div class="card smart-card">
    <div class="card-header">Thông tin nhân viên</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.User.Email</dd>
            <dt class="col-sm-4">Điện thoại</dt><dd class="col-sm-8">@(Model.Phone ?? "Chưa cập nhật")</dd>
            <dt class="col-sm-4">Ngày sinh</dt><dd class="col-sm-8">@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</dd>
            <dt class="col-sm-4">Giới tính</dt><dd class="col-sm-8">@(Model.Gender switch { "MALE" => "Nam", "FEMALE" => "Nữ", "OTHER" => "Khác", _ => "Chưa cập nhật" })</dd>
            <dt class="col-sm-4">Chức vụ</dt><dd class="col-sm-8">@Model.Position</dd>
            <dt class="col-sm-4">Avatar</dt><dd class="col-sm-8 text-break">@(Model.Avatar ?? "Chưa cập nhật")</dd>
            <dt class="col-sm-4">Trạng thái tài khoản</dt><dd class="col-sm-8"><span class="badge @(Model.User.IsActive ? "badge-soft-success" : "badge-soft-danger")">@(Model.User.IsActive ? "Hoạt động" : "Đã khóa")</span></dd>
            <dt class="col-sm-4">Ngày tạo</dt><dd class="col-sm-8">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
        <form asp-action="ToggleStatus" asp-route-id="@Model.EmployeeId" method="post" class="mt-3">
            <button type="submit" class="btn @(Model.User.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(Model.User.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")</button>
        </form>
    </div>
</div>
