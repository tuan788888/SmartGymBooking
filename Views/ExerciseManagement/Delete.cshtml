@model SmartGymBooking.Models.Exercise

@{
    ViewData["Title"] = "Xóa bài tập";
}

<div class="row justify-content-center">

    <div class="col-lg-6">

        <div class="smart-card">

            <div class="card-body">

                <h3>
                    Xóa bài tập
                </h3>

                <div class="alert alert-danger mt-3">

                    Bạn có chắc chắn muốn xóa bài tập này?

                </div>


                <h5>
                    @Model.Name
                </h5>

                <p>
                    <strong>Nhóm cơ:</strong>
                    @Model.MuscleGroup
                </p>

                <p>
                    <strong>Độ khó:</strong>
                    @Model.Difficulty
                </p>


                <form asp-action="DeleteConfirmed"
                      asp-route-id="@Model.ExerciseId"
                      method="post">

                    @Html.AntiForgeryToken()

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Hủy

                    </a>

                    <button type="submit"
                            class="btn btn-danger">

                        Xác nhận xóa

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>
