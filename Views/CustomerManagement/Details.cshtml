@model SmartGymBooking.Models.Customer

@{
    ViewData["Title"] = "Chi tiết khách hàng";
}

<div class="container">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }


    <div class="d-flex justify-content-between mb-4">

        <div>
            <h2>@Model.FullName</h2>
            <p class="text-muted">
                Customer #@Model.CustomerId
            </p>
        </div>

        <div>

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                Quay lại

            </a>

            @if (User.IsInRole("ADMIN"))
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.CustomerId"
                   class="btn btn-warning">

                    Sửa thông tin

                </a>
            }

        </div>

    </div>


    <div class="row g-4">

        <div class="col-lg-6">

            <div class="card shadow-sm">

                <div class="card-header">
                    Thông tin tài khoản
                </div>

                <div class="card-body">

                    <p>
                        <strong>Email:</strong>
                        @Model.User.Email
                    </p>

                    <p>
                        <strong>Điện thoại:</strong>
                        @Model.Phone
                    </p>

                    <p>
                        <strong>Ngày sinh:</strong>
                        @Model.DateOfBirth
                    </p>

                    <p>
                        <strong>Giới tính:</strong>
                        @Model.Gender
                    </p>

                    <p>
                        <strong>Trạng thái:</strong>

                        @if (Model.User.IsActive)
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Locked
                            </span>
                        }

                    </p>

                </div>

            </div>

        </div>


        <div class="col-lg-6">

            <div class="card shadow-sm">

                <div class="card-header">
                    Thông tin tập luyện
                </div>

                <div class="card-body">

                    <p>
                        <strong>Chiều cao:</strong>
                        @Model.Height cm
                    </p>

                    <p>
                        <strong>Cân nặng:</strong>
                        @Model.Weight kg
                    </p>

                    <p>
                        <strong>Mục tiêu:</strong>
                        @Model.FitnessGoal
                    </p>

                    <p>
                        <strong>Trình độ:</strong>
                        @Model.ExperienceLevel
                    </p>

                    <p>
                        <strong>Mức vận động:</strong>
                        @Model.ActivityLevel
                    </p>

                    <p>
                        <strong>Số buổi mong muốn:</strong>
                        @Model.PreferredSessionsPerWeek
                    </p>

                    <p>
                        <strong>Thời lượng:</strong>
                        @Model.PreferredSessionMinutes phút
                    </p>

                </div>

            </div>

        </div>

    </div>


    <div class="card shadow-sm mt-4">

        <div class="card-header">
            Membership
        </div>

        <div class="card-body">

            @if (Model.Memberships.Any())
            {
                <table class="table">

                    <thead>

                        <tr>
                            <th>Gói</th>
                            <th>Bắt đầu</th>
                            <th>Kết thúc</th>
                            <th>Trạng thái</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var membership in Model.Memberships)
                        {
                            <tr>

                                <td>
                                    @membership.Package.Name
                                </td>

                                <td>
                                    @membership.StartDate
                                </td>

                                <td>
                                    @membership.EndDate
                                </td>

                                <td>
                                    @membership.Status
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <p class="text-muted">
                    Khách hàng chưa có Membership.
                </p>
            }

        </div>

    </div>

</div>
