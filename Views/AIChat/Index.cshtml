@model SmartGymBooking.ViewModels.AIChatViewModel
@{
    ViewData["Title"] = "AI Virtual PT";
}
<div class="mb-4">
    <h2 class="page-title">AI Virtual PT</h2>
    <p class="page-subtitle">Trao đổi về mục tiêu, chỉ số cơ thể và giáo án của bạn.</p>
    <span class="badge bg-secondary">@(Model.AIProvider == "OPENAI" ? "AI Online" : "Demo AI — không gọi API")</span>
</div>
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
<div class="row g-4">
    <aside class="col-lg-3">
        <div class="smart-card p-3">
            <form asp-action="NewConversation" method="post" class="mb-3">
                <button type="submit" class="btn btn-smart-primary w-100">+ Cuộc trò chuyện mới</button>
            </form>
            <nav aria-label="Lịch sử trò chuyện" class="list-group">
                @foreach (var conversation in Model.Conversations)
                {
                    <a asp-action="Index" asp-route-conversationId="@conversation.AiconversationId"
                       class="list-group-item list-group-item-action text-break @(Model.ConversationId == conversation.AiconversationId ? "active" : "")">
                        @(conversation.Title ?? "AI Virtual PT")
                    </a>
                }
                @if (!Model.Conversations.Any())
                {
                    <p class="text-muted">Chưa có cuộc trò chuyện.</p>
                }
            </nav>
        </div>
    </aside>
    <section class="col-lg-9" aria-label="Nội dung trò chuyện">
        <div class="smart-card p-4">
            <h3 class="h5 text-break">@Model.ConversationTitle</h3>
            <div class="my-4">
                @if (!Model.Messages.Any())
                {
                    <p class="text-muted">Xin chào! Bạn có thể hỏi “BMI của tôi” hoặc “Giáo án của tôi”.</p>
                }
                @foreach (var message in Model.Messages)
                {
                    <div class="rounded p-3 mb-3 @(message.Role == "USER" ? "bg-light" : "border")">
                        <strong>@(message.Role == "USER" ? "Bạn" : "AI PT")</strong>
                        <div style="white-space: pre-wrap; overflow-wrap: anywhere;">@message.Content</div>
                    </div>
                }
            </div>
            <form asp-action="Send" method="post" id="ai-chat-form">
                <input asp-for="ConversationId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <label asp-for="Message" class="form-label">Câu hỏi của bạn</label>
                <textarea asp-for="Message" class="form-control" rows="3" maxlength="2000"
                          placeholder="Bạn muốn hỏi gì về việc tập luyện?" required></textarea>
                <span asp-validation-for="Message" class="text-danger"></span>
                <div class="mt-3 text-end"><button type="submit" class="btn btn-smart-primary">Gửi câu hỏi</button></div>
            </form>
        </div>
    </section>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('ai-chat-form').addEventListener('submit', function () {
            if (this.checkValidity() && (!window.jQuery || window.jQuery(this).valid())) {
                const button = this.querySelector('button[type="submit"]');
                button.disabled = true;
                button.textContent = 'Đang trả lời…';
            }
        });
    </script>
}
