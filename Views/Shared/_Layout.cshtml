<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SmartGym</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

<header>
    <nav class="navbar navbar-expand-lg smartgym-navbar">

        <div class="container">

            <a class="smartgym-brand"
               asp-controller="Home"
               asp-action="Index">
                SMART<span>GYM</span>
            </a>

            <button class="navbar-toggler navbar-dark"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Mở menu điều hướng">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse"
                 id="mainNavbar">

                <ul class="navbar-nav me-auto">

                    @if (User.IsInRole("ADMIN"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="ServiceManagement" asp-action="Index">Dịch vụ</a></li><li class="nav-item"><a class="nav-link" asp-controller="BookingManagement" asp-action="Index">Booking</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="PaymentManagement" asp-action="Index">Thanh toán</a></li>
<li class="nav-item">
                            <a class="nav-link"
                               asp-controller="AdminDashboard"
                               asp-action="Index">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="CustomerManagement"
                               asp-action="Index">
                                Khách hàng
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="EmployeeManagement"
                               asp-action="Index">
                                Nhân viên
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="PTManagement" asp-action="Index">
                                PT
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="PackageManagement" asp-action="Index">
                                Gói tập
                            </a>
                        </li>
                    }

                    else if (User.IsInRole("EMPLOYEE"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="PaymentManagement" asp-action="Index">Thanh toán</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Package" asp-action="Index">Gói tập</a></li>
<li class="nav-item">
                            <a class="nav-link"
                               asp-controller="EmployeeDashboard"
                               asp-action="Index">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="CustomerManagement"
                               asp-action="Index">
                                Khách hàng
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="BookingManagement" asp-action="Index">
                                Booking
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                Check-in
                            </a>
                        </li>
                    }

                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Trang chủ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Package" asp-action="Index">
                                Gói tập
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                Dịch vụ
                            </a>
                        </li>

                        @if (User.IsInRole("CUSTOMER"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Payment" asp-action="History">Thanh toán của tôi</a></li><li class="nav-item"><a class="nav-link" asp-controller="Membership" asp-action="Index">Membership</a></li>
<li class="nav-item">
                                <a class="nav-link" asp-controller="Booking" asp-action="Index">
                                    Lịch của tôi
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="#">
                                    AI PT
                                </a>
                            </li>
                        }
                    }

                </ul>

                <ul class="navbar-nav ms-auto align-items-lg-center">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item me-lg-3">
                            <span class="nav-link">
                                @User.Identity.Name
                            </span>
                        </li>

                        <li class="nav-item">
                            <form asp-controller="Auth"
                                  asp-action="Logout"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button class="btn btn-outline-light">
                                    Đăng xuất
                                </button>

                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Auth"
                               asp-action="Login">
                                Đăng nhập
                            </a>
                        </li>

                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-success"
                               asp-controller="Auth"
                               asp-action="Register">
                                Đăng ký
                            </a>
                        </li>
                    }

                </ul>

            </div>

        </div>

    </nav>
</header>


<main class="container page-shell">
    @RenderBody()
</main>


<footer class="smart-footer py-4">
    <div class="container d-flex justify-content-between">
        <span>© @DateTime.Now.Year SmartGym Booking</span>
        <span>Graduation Project</span>
    </div>
</footer>


<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true"></script>

@await RenderSectionAsync(
    "Scripts",
    required: false
)

</body>

</html>
