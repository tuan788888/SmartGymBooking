@model IEnumerable<SmartGymBooking.Models.Package>

@{
    ViewData["Title"] = "Gói tập";
}

<div class="text-center mb-5">

    <h1 class="page-title">
        Chọn gói tập phù hợp
    </h1>

    <p class="page-subtitle">
        Bắt đầu hành trình tập luyện tại SmartGym
    </p>

</div>


<div class="row g-4 justify-content-center">

    @if (!Model.Any())
    {
        <div class="col-12 text-center text-muted">Hiện chưa có gói tập đang hoạt động.</div>
    }

    @foreach (var package in Model)
    {
        <div class="col-lg-4 col-md-6">

            <div class="smart-card h-100">

                <div class="card-body p-4">

                    @if (package.IncludesPt)
                    {
                        <span class="badge bg-success mb-3">
                            Có Personal Trainer
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary mb-3">
                            AI Virtual PT
                        </span>
                    }


                    <h3>
                        @package.Name
                    </h3>


                    <h2 class="fw-bold my-3">

                        @package.Price.ToString("N0")

                        <small class="fs-6 text-muted">
                            đ
                        </small>

                    </h2>


                    <p class="text-muted">
                        @package.DurationDays ngày
                    </p>


                    <p>
                        @package.Description
                    </p>


                    @if (User.IsInRole("CUSTOMER"))
                    {
                        <a href="#"
                           class="btn btn-smart-success w-100 mt-3">

                            Chọn gói

                        </a>
                    }
                    else if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-controller="Auth"
                           asp-action="Login"
                           class="btn btn-smart-primary w-100 mt-3">

                            Đăng nhập để mua

                        </a>
                    }

                </div>

            </div>

        </div>
    }

</div>
