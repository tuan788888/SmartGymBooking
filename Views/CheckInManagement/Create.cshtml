@model IEnumerable<SmartGymBooking.Models.Booking>

@{
    ViewData["Title"] = "Check-in khách hàng";
}

<div class="mb-4">

    <h2 class="page-title">
        Check-in khách hàng
    </h2>

    <p class="page-subtitle">
        Chọn lịch đang diễn ra để check-in. Hệ thống tự ghi giờ hiện tại. Phòng mở cửa 06:00–22:00 (giờ Việt Nam).
    </p>

</div>


@if (ViewBag.IsGymOpen == false)
{
    <div class="alert alert-info">Phòng tập đang đóng cửa.</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}


<div class="table-shell">

    <div class="table-responsive">

        <table class="table align-middle">

            <thead>

                <tr>
                    <th>Khách hàng</th>
                    <th>Dịch vụ</th>
                    <th>Bắt đầu</th>
                    <th>Kết thúc</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>

            </thead>

            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Không có lịch check-in.</td></tr>
                }

                @foreach (var booking in Model)
                {
                    <tr data-booking-id="@booking.BookingId" data-booking-status="@booking.Status">

                        <td>
                            @booking.Customer.FullName
                        </td>

                        <td>
                            @booking.Service.Name
                        </td>

                        <td>
                            @booking.StartTime.ToString(
                                "dd/MM/yyyy HH:mm"
                            )
                        </td>

                        <td>
                            @booking.EndTime.ToString(
                                "dd/MM/yyyy HH:mm"
                            )
                        </td>

                        <td>
                            @if (booking.Status == "CANCELLED")
                            {
                                <span class="badge bg-secondary">Đã hủy check-in</span>
                                <div class="small text-muted mt-1">Đã quá giờ kết thúc</div>
                            }
                            else
                            {
                                <span class="badge bg-success">Đã xác nhận</span>
                            }
                        </td>

                        <td>
                            @if (ViewBag.IsGymOpen == true)
                            {
                                <form asp-action="CheckIn"
                                      asp-route-bookingId="@booking.BookingId"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success">Check-in</button>
                                </form>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@section Scripts {
    <script>
        window.setInterval(() => {
            if (document.visibilityState === 'visible' && !document.querySelector('form[data-submitting]')) {
                window.location.reload();
            }
        }, 30000);
        document.querySelectorAll('form[method="post"]').forEach(form => {
            form.addEventListener('submit', () => form.dataset.submitting = 'true');
        });
    </script>
}


<div class="mt-3">

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        Quay lại

    </a>

</div>
