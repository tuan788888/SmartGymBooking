@model SmartGymBooking.ViewModels.ServiceViewModel

@{
    ViewData["Title"] = "Thêm dịch vụ";
}

<div class="row justify-content-center">

    <div class="col-lg-7">

        <div class="smart-card">

            <div class="card-header">
                <h4>Thêm dịch vụ</h4>
            </div>

            <div class="card-body">

                <form asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">

                        <label asp-for="Name"
                               class="form-label">
                            Tên dịch vụ
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Ví dụ: Boxing" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-3">

                        <label asp-for="Description"
                               class="form-label">
                            Mô tả
                        </label>

                        <textarea asp-for="Description"
                                  rows="4"
                                  class="form-control">
                        </textarea>

                    </div>


                    <div class="form-check mb-4">

                        <input asp-for="IsActive"
                               class="form-check-input" />

                        <label asp-for="IsActive"
                               class="form-check-label">
                            Đang hoạt động
                        </label>

                    </div>


                    <div class="d-flex justify-content-end gap-2">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Hủy
                        </a>

                        <button class="btn btn-smart-success"
                                type="submit">
                            Thêm dịch vụ
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
