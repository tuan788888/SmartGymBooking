@model SmartGymBooking.Models.Payment

@{
    ViewData["Title"] = "Chi tiết thanh toán";
}

<div class="row justify-content-center">

    <div class="col-xl-8">

        <div class="smart-card">

            <div class="card-header">

                <h4>
                    Chi tiết giao dịch
                </h4>

            </div>


            <div class="card-body">

                @if (TempData["ErrorMessage"] is string paymentError)
                {
                    <div class="alert alert-warning" role="alert">@paymentError</div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["SuccessMessage"]
                    </div>
                }


                <div class="row">

                    <div class="col-md-6">

                        <p>
                            <strong>Mã:</strong><br />
                            @Model.PaymentCode
                        </p>

                        <p>
                            <strong>Khách hàng:</strong><br />
                            @Model.Customer.FullName
                        </p>

                        <p>
                            <strong>Email:</strong><br />
                            @Model.Customer.User.Email
                        </p>

                    </div>


                    <div class="col-md-6">

                        <p>
                            <strong>Gói:</strong><br />
                            @Model.Package.Name
                        </p>

                        <p>
                            <strong>Số tiền:</strong><br />

                            <span class="fs-4 fw-bold">
                                @Model.Amount.ToString("#,0.##") đ
                            </span>
                        </p>

                        <p>
                            <strong>Trạng thái:</strong><br />
                            <span class="badge @(Model.Status switch { "PAID" => "bg-success", "PENDING" => "bg-warning text-dark", "FAILED" => "bg-danger", _ => "bg-secondary" })">@Model.Status</span>
                        </p>

                    </div>

                </div>


                @if (Model.Status == "PENDING")
                {
                    <hr />


                    <div class="alert alert-warning">

                        Chỉ xác nhận PAID sau khi đã kiểm tra
                        khách hàng thực sự chuyển khoản.

                    </div>


                    <div class="d-flex gap-2">

                        <form asp-action="Confirm"
                              asp-route-id="@Model.PaymentId"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-success">

                                Xác nhận đã thanh toán

                            </button>

                        </form>


                        <form asp-action="MarkFailed"
                              asp-route-id="@Model.PaymentId"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-danger">

                                Đánh dấu thất bại

                            </button>

                        </form>

                    </div>
                }


                @if (Model.BankReference is string reference)
                {
                    <div class="alert alert-info">
                        Đã đối soát theo mã ngân hàng <strong>@reference</strong>.
                        Admin xử lý #@Model.ReconciledByUserId
                        lúc @Model.ConfirmedAt?.ToString("dd/MM/yyyy HH:mm").
                    </div>
                }
                else if (User.IsInRole("ADMIN") && Model.Status == "CANCELLED" &&
                    (Model.PaidAt ?? Model.CreatedAt) <= SmartGymBooking.Services.GymTime.Now -
                        SmartGymBooking.Services.PackagePurchase.ConfirmationWindow)
                {
                    <hr />
                    <h5>Đối soát giao dịch đã hủy</h5>
                    <p class="text-muted">Chỉ thực hiện sau khi kiểm tra trực tiếp giao dịch trên sao kê ngân hàng.</p>
                    <form asp-action="Reconcile" asp-route-id="@Model.PaymentId" method="post" class="row g-3">
                        <div class="col-md-4">
                            <label for="bankReference" class="form-label">Mã tham chiếu ngân hàng</label>
                            <input id="bankReference" name="bankReference" class="form-control" maxlength="100" required />
                        </div>
                        <div class="col-md-4">
                            <label for="receivedAmount" class="form-label">Số tiền thực nhận (đ)</label>
                            <input id="receivedAmount" name="receivedAmount" class="form-control" type="number" min="1" step="1" required />
                        </div>
                        <div class="col-md-4">
                            <label for="receivedAt" class="form-label">Giờ chuyển khoản (giờ Việt Nam)</label>
                            <input id="receivedAt" name="receivedAt" class="form-control" type="datetime-local" required />
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-success">Xác nhận đối soát</button>
                        </div>
                    </form>
                }

                <div class="mt-4">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Quay lại

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
