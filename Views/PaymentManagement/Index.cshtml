@model IEnumerable<SmartGymBooking.Models.Payment>

@{
    ViewData["Title"] = "Quản lý thanh toán";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="page-title">
            Thanh toán
        </h2>

        <p class="page-subtitle">
            Xác nhận giao dịch mua gói của khách hàng
        </p>

    </div>

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}


<div class="smart-card mb-4">

    <div class="card-body">

        <form method="get"
              class="row g-2">

            <div class="col-md-5">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Mã giao dịch, khách hàng, email..." />

            </div>


            <div class="col-md-3">

                <select name="status"
                        class="form-select">

                    <option value="">
                        Tất cả trạng thái
                    </option>

                    <option value="PENDING" selected="@(ViewBag.Status == "PENDING")">
                        PENDING
                    </option>

                    <option value="PAID" selected="@(ViewBag.Status == "PAID")">
                        PAID
                    </option>

                    <option value="FAILED" selected="@(ViewBag.Status == "FAILED")">
                        FAILED
                    </option>

                    <option value="CANCELLED" selected="@(ViewBag.Status == "CANCELLED")">
                        CANCELLED
                    </option>

                </select>

            </div>


            <div class="col-auto">

                <button type="submit"
                        class="btn btn-smart-primary">

                    Lọc

                </button>

            </div>


            <div class="col-auto">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    Làm mới

                </a>

            </div>

        </form>

    </div>

</div>


<div class="table-shell">

    <div class="table-responsive">

        <table class="table align-middle">

            <thead>

                <tr>
                    <th>Mã</th>
                    <th>Khách hàng</th>
                    <th>Gói</th>
                    <th>Số tiền</th>
                    <th>Ngày tạo</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>

            </thead>


            <tbody>

                @foreach (var payment in Model)
                {
                    <tr>

                        <td>
                            <strong>
                                @payment.PaymentCode
                            </strong>
                        </td>

                        <td>

                            @payment.Customer.FullName

                            <div class="small text-muted">
                                @payment.Customer.User.Email
                            </div>

                        </td>

                        <td>
                            @payment.Package.Name
                        </td>

                        <td>
                            @payment.Amount.ToString("N0") đ
                        </td>

                        <td>
                            @payment.CreatedAt.ToString(
                                "dd/MM/yyyy HH:mm"
                            )
                        </td>

                        <td>

                            @if (payment.Status == "PAID")
                            {
                                <span class="badge bg-success">
                                    PAID
                                </span>
                            }
                            else if (payment.Status == "PENDING")
                            {
                                <span class="badge bg-warning text-dark">
                                    PENDING
                                </span>
                            }
                            else if (payment.Status == "CANCELLED")
                            {
                                <span class="badge bg-secondary">
                                    CANCELLED
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    @payment.Status
                                </span>
                            }

                        </td>


                        <td>

                            <a asp-action="Details"
                               asp-route-id="@payment.PaymentId"
                               class="btn btn-sm btn-outline-primary">

                                Chi tiết

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
