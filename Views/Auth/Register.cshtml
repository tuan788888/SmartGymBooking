@model SmartGymBooking.ViewModels.RegisterViewModel

@{
    var managed = ViewContext.RouteData.Values["action"]?.ToString() == "CreateCustomer";
    ViewData["Title"] = managed ? "Thêm khách hàng" : "Đăng ký";
}

<div class="auth-shell">
@if (!managed)
{
    <aside class="auth-story"><span class="section-eyebrow">BẮT ĐẦU CÙNG SMARTGYM</span><h1>Một khởi đầu.<br /><em>Nhiều thay đổi.</em></h1><p>Tạo tài khoản để chọn gói tập, đặt lịch linh hoạt và xây dựng thói quen cho riêng bạn.</p><a asp-controller="Package" asp-action="Index">Tìm gói tập phù hợp ↗</a></aside>
}

    <div class="row justify-content-center auth-form-row">

        <div class="col-12">

            <div class="card auth-panel">

                <div class="card-body auth-panel-body">

                    <h2 class="auth-title">
                        @(managed ? "Thêm khách hàng" : "Đăng ký SmartGym")
                    </h2>


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <form asp-action="@(managed ? "CreateCustomer" : "Register")"
                          method="post">

                        @Html.AntiForgeryToken()


                        <div class="mb-3">

                            <label asp-for="FullName"
                                   class="form-label">
                                Họ và tên
                            </label>

                            <input asp-for="FullName" autocomplete="name"
                                   class="form-control" />

                            <span asp-validation-for="FullName"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label">
                                Email
                            </label>

                            <input asp-for="Email" type="email" autocomplete="email" maxlength="40"
                                   class="form-control" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="Phone"
                                   class="form-label">
                                Số điện thoại
                            </label>

                            <input asp-for="Phone" type="tel" inputmode="numeric" maxlength="11" autocomplete="tel"
                                   class="form-control" />

                            <span asp-validation-for="Phone"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="DateOfBirth"
                                   class="form-label">
                                Ngày sinh
                            </label>

                            <input asp-for="DateOfBirth"
                                   class="form-control" />
                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="Gender"
                                   class="form-label">
                                Giới tính
                            </label>

                            <select asp-for="Gender"
                                    class="form-select">

                                <option value="">
                                    -- Chọn giới tính --
                                </option>

                                <option value="MALE">
                                    Nam
                                </option>

                                <option value="FEMALE">
                                    Nữ
                                </option>

                                <option value="OTHER">
                                    Khác
                                </option>

                            </select><span asp-validation-for="Gender" class="text-danger"></span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="Password"
                                   class="form-label">
                                Mật khẩu
                            </label>

                            <input asp-for="Password" autocomplete="new-password"
                                   class="form-control" />

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="ConfirmPassword"
                                   class="form-label">
                                Xác nhận mật khẩu
                            </label>

                            <input asp-for="ConfirmPassword" autocomplete="new-password"
                                   class="form-control" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger">
                            </span>

                        </div>


                        <button type="submit"
                                class="btn btn-smart-success w-100">

                            @(managed ? "Thêm khách hàng" : "Đăng ký")

                        </button>

                    </form>


                    @if (managed)
                    {
                        <div class="text-center auth-switch">
                            <a asp-controller="CustomerManagement" asp-action="Index">Quay lại danh sách khách hàng</a>
                        </div>
                    }
                    else
                    {
                    <div class="text-center auth-switch">

                        Đã có tài khoản?

                        <a asp-controller="Auth"
                           asp-action="Login">

                            Đăng nhập

                        </a>

                    </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
