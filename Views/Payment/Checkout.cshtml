@model SmartGymBooking.ViewModels.PaymentCheckoutViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment

@{
    ViewData["Title"] = "Thanh toán";
}

<div class="row justify-content-center">

    <div class="col-xl-9">

        <div class="row g-4">

            <div class="col-lg-6">

                <div class="smart-card h-100">

                    <div class="card-body p-4">

                        <span class="badge mb-3 @(Model.Status switch { "PAID" => "bg-success", "PENDING" => "bg-warning text-dark", "FAILED" => "bg-danger", _ => "bg-secondary" })">
                            @Model.Status
                        </span>

                        <h2 class="mb-4">
                            @(Model.IsUpgrade ? "Thanh toán nâng cấp gói PT" : "Thanh toán gói tập")
                        </h2>


                        <div class="mb-3">

                            <div class="text-muted">
                                Gói tập
                            </div>

                            <h5>
                                @Model.PackageName
                            </h5>

                        </div>


                        <div class="mb-3">

                            <div class="text-muted">
                                Thời hạn
                            </div>

                            <strong>
                                @(Model.UpgradeEndsAt is DateTime expires ? $"Đến {expires:dd/MM/yyyy HH:mm}" : $"{Model.DurationDays} ngày")
                            </strong>

                        </div>


                        <div class="mb-3">

                            <div class="text-muted">
                                Personal Trainer
                            </div>

                            @if (Model.IncludesPT)
                            {
                                <span class="badge bg-success">
                                    Có PT
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Không bao gồm PT
                                </span>
                            }

                        </div>


                        <hr />


                        <div class="text-muted">
                            Tổng thanh toán
                        </div>

                        <h2 class="fw-bold">
                            @Model.Amount.ToString("#,0.##") đ
                        </h2>


                        @if (Model.IsUpgrade)
                        {
                            <p class="text-success">Đã áp dụng giá ưu đãi nâng cấp gói PT.</p>
                        }
                        @if (Model.PaymentError is string paymentError)
                        {
                            <div class="alert alert-warning mt-4" role="alert">@paymentError</div>
                        }
                        else if (Model.Status == "CANCELLED")
                        {
                            <div class="alert alert-secondary mt-4">Giao dịch đã hủy. Nếu bạn đã chuyển khoản, hãy liên hệ phòng gym để đối soát.</div>
                        }
                        else if (Model.Status == "PENDING")
                        {
                        <div class="alert alert-warning mt-4">

                            Giao dịch cần được xác nhận trước <strong>@Model.ConfirmationDeadline.ToString("dd/MM/yyyy HH:mm")</strong>.
                            Yêu cầu sẽ tự hủy khi quá hạn. Nếu đã chuyển khoản mà giao dịch bị hủy, hãy liên hệ phòng gym để đối soát.

                        </div>
                        }

                    </div>

                </div>

            </div>


            <div class="col-lg-6">

                <div class="smart-card h-100">

                    <div class="card-body p-4 text-center">

                        <h4 class="mb-3">
                            Quét mã QR
                        </h4>

                        @if (Model.Status == "PENDING" && Model.PaymentError == null)
                        {
                        @if (System.IO.File.Exists(System.IO.Path.Combine(Environment.WebRootPath, "images", "payment", "bank-qr.jpg")))
                        {
                        <img src="@Model.QrImageUrl"
                             alt="QR thanh toán"
                             class="img-fluid rounded"
                             style="max-width:300px;" />
                        }
                        <dl class="mt-3">
                            <dt>Ngân hàng</dt><dd>Vietcombank</dd>
                            <dt>Chủ tài khoản</dt><dd>LE ANH TUAN</dd>
                            <dt>Số tài khoản</dt><dd>1041192956</dd>
                        </dl>
                        <p>Nhập số tiền @Model.Amount.ToString("#,0.##") đ và nội dung bên dưới khi chuyển khoản.</p>


                        <div class="mt-4">

                            <div class="text-muted">
                                Nội dung chuyển khoản
                            </div>

                            <div class="border rounded p-3 mt-2">

                                <strong class="fs-5">
                                    @Model.PaymentCode
                                </strong>

                            </div>

                        </div>


                        <p class="text-danger mt-3 mb-0">

                            Vui lòng nhập đúng nội dung
                            chuyển khoản.

                        </p>
                        }
                        else
                        {
                            <p>Giao dịch này hiện không thể thanh toán.</p>
                        }

                    </div>

                </div>

            </div>

        </div>


        <div class="text-center mt-4">

            <a asp-action="History"
               class="btn btn-outline-dark">

                Xem lịch sử thanh toán

            </a>

        </div>

    </div>

</div>
