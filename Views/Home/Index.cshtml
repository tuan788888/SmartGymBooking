@{
    ViewData["Title"] = "Trang chủ";
}

<section class="hero-section">

    <span class="hero-badge">
        Smart Fitness Platform
    </span>

    <h1>
        Tập luyện thông minh hơn cùng SmartGym
    </h1>

    <p class="mt-3">
        Quản lý gói tập, đặt lịch dịch vụ, theo dõi lịch PT
        và nhận giáo án cá nhân hóa từ AI Virtual Trainer.
    </p>

    @if (User.Identity?.IsAuthenticated != true)
    {
        <div class="mt-4">

            <a asp-controller="Auth"
               asp-action="Register"
               class="btn btn-success btn-lg me-2">

                Bắt đầu ngay

            </a>

            <a asp-controller="Auth"
               asp-action="Login"
               class="btn btn-outline-light btn-lg">

                Đăng nhập

            </a>

        </div>
    }

</section>


<div class="row g-4">

    <div class="col-md-4">

        <div class="smart-card h-100">

            <div class="card-body">

                <h4>Đặt lịch nhanh</h4>

                <p class="text-muted">
                    Chọn loại hình tập và lịch phù hợp
                    trực tiếp trên hệ thống.
                </p>

            </div>

        </div>

    </div>


    <div class="col-md-4">

        <div class="smart-card h-100">

            <div class="card-body">

                <h4>Personal Trainer</h4>

                <p class="text-muted">
                    Khách hàng Premium được sắp xếp lịch
                    tập cùng PT phù hợp.
                </p>

            </div>

        </div>

    </div>


    <div class="col-md-4">

        <div class="smart-card h-100">

            <div class="card-body">

                <h4>AI Virtual PT</h4>

                <p class="text-muted">
                    Nhận giáo án và tư vấn tập luyện
                    cá nhân hóa bằng AI.
                </p>

            </div>

        </div>

    </div>

</div>
