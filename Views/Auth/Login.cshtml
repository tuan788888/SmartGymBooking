@model SmartGymBooking.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-shell"><aside class="auth-story"><span class="section-eyebrow">CHÀO MỪNG TRỞ LẠI</span><h1>Giữ nhịp tập.<br /><em>Tiếp đà tiến bộ.</em></h1><p>Lịch tập, gói thành viên và huấn luyện viên của bạn, trong một không gian.</p><a asp-controller="Package" asp-action="Index">Khám phá gói tập ↗</a></aside>

    <div class="row justify-content-center auth-form-row">

        <div class="col-12">

            <div class="card auth-panel">

                <div class="card-body auth-panel-body">

                    <h2 class="auth-title">
                        Đăng nhập SmartGym
                    </h2>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <form asp-action="Login"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label">
                                Email
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   type="email" autocomplete="username" placeholder="ban@example.com" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="Password"
                                   class="form-label">
                                Mật khẩu
                            </label>

                            <input asp-for="Password"
                                   class="form-control"
                                   autocomplete="current-password" placeholder="Nhập mật khẩu" />

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="form-check mb-3">

                            <input asp-for="RememberMe"
                                   class="form-check-input" />

                            <label asp-for="RememberMe"
                                   class="form-check-label">
                                Ghi nhớ đăng nhập
                            </label>

                        </div>


                        <button type="submit"
                                class="btn btn-smart-success w-100">

                            Đăng nhập

                        </button>

                    </form>


                    <div class="text-center auth-switch">

                        Chưa có tài khoản?

                        <a asp-controller="Auth"
                           asp-action="Register">

                            Đăng ký

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
