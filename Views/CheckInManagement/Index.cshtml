@model IEnumerable<SmartGymBooking.Models.CheckIn>

@{
    ViewData["Title"] = "Check-in";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="page-title">
            Check-in
        </h2>

        <p class="page-subtitle">
            Lịch sử khách hàng vào phòng tập
        </p>

    </div>

    <a asp-action="Create"
       class="btn btn-smart-success">

        + Check-in khách hàng

    </a>

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}


<form asp-action="WalkIn" method="post" class="smart-card p-3 mb-4">
    <label for="walkInCustomer" class="form-label fw-semibold">Check-in trực tiếp cho khách chưa đặt lịch</label>
    <p class="text-muted mb-2">Hệ thống ghi giờ hiện tại. Phòng mở cửa 06:00–22:00 (giờ Việt Nam).</p>
    <div class="d-flex gap-2 flex-wrap">
        <select id="walkInCustomer" name="customerId" asp-items="ViewBag.WalkInCustomers" class="form-select w-auto mw-100" required>
            <option value="">Chọn khách có gói đang hoạt động</option>
        </select>
        <button type="submit" class="btn btn-smart-success">Check-in trực tiếp</button>
    </div>
</form>

<div class="table-shell">

    <div class="table-responsive">

        <table class="table align-middle">

            <thead>

                <tr>
                    <th>ID</th>
                    <th>Khách hàng</th>
                    <th>Dịch vụ</th>
                    <th>Booking</th>
                    <th>Check-in lúc</th>
                </tr>

            </thead>

            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Chưa có lịch sử check-in.</td></tr>
                }

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            @item.CheckInId
                        </td>

                        <td>
                            <strong>
                                @item.Customer.FullName
                            </strong>
                        </td>

                        <td>
                            @(item.Booking != null
                                ? item.Booking.Service.Name
                                : "Check-in tự do")
                        </td>

                        <td>
                            @(item.BookingId?.ToString() ?? "-")
                        </td>

                        <td>
                            @item.CheckInTime.ToString(
                                "dd/MM/yyyy HH:mm"
                            )
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
