@model SmartGymBooking.ViewModels.AIChatViewModel

@{
    ViewData["Title"] = "AI Virtual PT";

    var conversations = Model.Conversations;
    var provider = Model.AIProvider;
}


<div class="row g-4">

    <div class="col-lg-3">

        <div class="smart-card">

            <div class="card-body">

                <h5>
                    AI Virtual PT
                </h5>

                <p class="small text-muted">
                    Trợ lý tập luyện SmartGym
                </p>


                <form asp-action="NewConversation"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn
                                   btn-smart-success
                                   w-100">

                        + Cuộc trò chuyện mới

                    </button>

                </form>


                <hr />


                <small class="text-muted">
                    Lịch sử
                </small>


                <div class="mt-2">

                    @if (conversations != null)
                    {
                        foreach (var conversation
                                 in conversations)
                        {
                            <a asp-action="Index"
                               asp-route-conversationId="@conversation.AiconversationId"
                               class="d-block
                                      border
                                      rounded
                                      p-2
                                      mb-2
                                      text-decoration-none text-break @(Model.ConversationId == conversation.AiconversationId ? "bg-light border-success" : "")">

                                <div class="fw-semibold text-dark">

                                    @conversation.Title

                                </div>

                                <small class="text-muted">

                                    @conversation.CreatedAt.ToString("dd/MM/yyyy HH:mm")

                                </small>

                            </a>
                        }
                    }

                </div>

            </div>

        </div>

    </div>


    <div class="col-lg-9">

        <div class="smart-card">

            <div class="card-header
                        d-flex
                        justify-content-between
                        align-items-center">

                <div>

                    <h4 class="mb-1">
                        @Model.ConversationTitle
                    </h4>

                    <small class="text-muted">
                        Trợ lý tập luyện cá nhân
                    </small>

                </div>


                @if (provider == "OPENAI")
                {
                    <span class="badge bg-primary">
                        AI Online
                    </span>
                }
                else
                {
                    <span class="badge bg-success">
                        Demo AI • Free
                    </span>
                }

            </div>


            <div class="card-body">

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">

                        @TempData["ErrorMessage"]

                    </div>
                }


                <div id="chatMessages"
                     class="border
                            rounded
                            p-3
                            mb-3"
                     role="log" aria-label="Tin nhắn trò chuyện"
                     style="
                        height:500px;
                        overflow-y:auto;
                        background:#f8fafc;
                     ">


                    @if (!Model.Messages.Any())
                    {
                        <div class="text-center
                                    text-muted
                                    py-5">

                            <h4>
                                AI Virtual PT
                            </h4>

                            <p>
                                Hãy thử hỏi:
                            </p>

                            <div>
                                "Giáo án của tôi là gì?"
                            </div>

                            <div>
                                "BMI của tôi bao nhiêu?"
                            </div>

                            <div>
                                "Tôi muốn tăng cơ"
                            </div>

                            <div>
                                "Tôi nên tập ngực thế nào?"
                            </div>

                        </div>
                    }


                    @foreach (var message
                              in Model.Messages)
                    {
                        if (message.Role == "USER")
                        {
                            <div class="d-flex
                                        justify-content-end
                                        mb-3">

                                <div class="bg-dark
                                            text-white
                                            rounded
                                            p-3"
                                     style="
                                        max-width:75%;
                                        white-space:pre-wrap; overflow-wrap:anywhere;
                                     ">

                                    @message.Content

                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="d-flex
                                        justify-content-start
                                        mb-3">

                                <div class="bg-white
                                            border
                                            rounded
                                            p-3"
                                     style="
                                        max-width:80%;
                                        white-space:pre-wrap; overflow-wrap:anywhere;
                                     ">

                                    <div class="fw-bold
                                                text-success
                                                mb-1">

                                        AI PT

                                    </div>

                                    @message.Content

                                </div>

                            </div>
                        }
                    }

                </div>


                <form asp-action="Send"
                      method="post" id="ai-chat-form">

                    @Html.AntiForgeryToken()


                    <input asp-for="ConversationId"
                           type="hidden" />


                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <label asp-for="Message" class="form-label">Câu hỏi của bạn</label>
                    <div class="input-group">

                        <textarea asp-for="Message"
                                  class="form-control"
                                  rows="2"
                                  maxlength="2000" required
                                  placeholder="Hỏi AI PT..."
                                  style="resize:none;">
                        </textarea>


                        <button type="submit"
                                class="btn
                                       btn-smart-success
                                       px-4">

                            Gửi

                        </button>

                    </div>
                    <span asp-validation-for="Message" class="text-danger"></span>

                </form>


                <div class="small
                            text-muted
                            mt-2">

                    AI PT hỗ trợ thông tin tập luyện.
                    Không thay thế tư vấn y tế chuyên môn.

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script>

        const chat =
            document.getElementById(
                "chatMessages"
            );

        if (chat) {

            chat.scrollTop =
                chat.scrollHeight;

        }

        document.getElementById('ai-chat-form').addEventListener('submit', function () {
            if (this.checkValidity() && (!window.jQuery || window.jQuery(this).valid())) {
                const button = this.querySelector('button[type="submit"]');
                button.disabled = true;
                button.textContent = 'Đang trả lời…';
            }
        });

    </script>
}
