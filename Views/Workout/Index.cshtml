@model IEnumerable<SmartGymBooking.Models.WorkoutPlan>

@{
    ViewData["Title"] = "Giáo án của tôi";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>

    <h2 class="page-title">
        Giáo án của tôi
    </h2>

    <p class="page-subtitle">
        Giáo án tập luyện cá nhân hóa của SmartGym
    </p>

    </div>
    <form asp-action="Generate" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-smart-success">Tạo giáo án bằng AI</button>
    </form>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}


@if (!Model.Any())
{
    <div class="smart-card">

        <div class="card-body text-center py-5">

            <h4>
                Bạn chưa có giáo án
            </h4>

            <p class="text-muted">

                Hệ thống AI PT sẽ tạo giáo án dựa trên
                mục tiêu và thông tin tập luyện của bạn.

            </p>

        </div>

    </div>
}


<div class="row g-4">

    @foreach (var plan in Model)
    {
        <div class="col-lg-6">

            <div class="smart-card h-100">

                <div class="card-body p-4">

                    <span class="badge bg-success mb-3">
                        Workout Plan
                    </span>


                    <h3>
                        @plan.Title
                    </h3>


                    @if (!string.IsNullOrWhiteSpace(
                        plan.PredictedPlanType))
                    {
                        <p class="text-muted">

                            Plan type:
                            <strong>
                                @plan.PredictedPlanType
                            </strong>

                        </p>
                    }


                    @if (!string.IsNullOrWhiteSpace(
                        plan.ModelName))
                    {
                        <div class="small text-muted">

                            Generated by:
                            @plan.ModelName
                            @plan.ModelVersion

                        </div>
                    }


                    <div class="mt-4">

                        <a asp-action="Details"
                           asp-route-id="@plan.WorkoutPlanId"
                           class="btn btn-smart-primary">

                            Xem giáo án

                        </a>

                    </div>

                </div>

            </div>

        </div>
    }

</div>
