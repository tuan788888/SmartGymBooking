@model SmartGymBooking.ViewModels.CustomerEditViewModel

@{
    ViewData["Title"] = "Sửa khách hàng";
}

<div class="container">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-header">

                    <h4 class="mb-0">
                        Sửa thông tin khách hàng
                    </h4>

                </div>

                <div class="card-body">

                    <form asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="CustomerId"
                               type="hidden" />


                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <div class="mb-3">

                            <label asp-for="FullName"
                                   class="form-label">

                                Họ tên

                            </label>

                            <input asp-for="FullName"
                                   class="form-control" />

                            <span asp-validation-for="FullName"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="Phone"
                                   class="form-label">

                                Điện thoại

                            </label>

                            <input asp-for="Phone"
                                   class="form-control" />

                            <span asp-validation-for="Phone"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="DateOfBirth"
                                   class="form-label">

                                Ngày sinh

                            </label>

                            <input asp-for="DateOfBirth"
                                   class="form-control" />

                        </div>


                        <div class="mb-3">

                            <label asp-for="Gender"
                                   class="form-label">

                                Giới tính

                            </label>

                            <select asp-for="Gender"
                                    class="form-select">

                                <option value="">
                                    -- Chọn --
                                </option>

                                <option value="MALE">
                                    Nam
                                </option>

                                <option value="FEMALE">
                                    Nữ
                                </option>

                                <option value="OTHER">
                                    Khác
                                </option>

                            </select>

                        </div>


                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="Height"
                                       class="form-label">

                                    Chiều cao (cm)

                                </label>

                                <input asp-for="Height"
                                       class="form-control" />

                            </div>


                            <div class="col-md-6 mb-3">

                                <label asp-for="Weight"
                                       class="form-label">

                                    Cân nặng (kg)

                                </label>

                                <input asp-for="Weight"
                                       class="form-control" />

                            </div>

                        </div>


                        <div class="mb-3">

                            <label asp-for="FitnessGoal"
                                   class="form-label">

                                Mục tiêu

                            </label>

                            <select asp-for="FitnessGoal"
                                    class="form-select">

                                <option value="">
                                    -- Chọn mục tiêu --
                                </option>

                                <option value="WEIGHT_LOSS">
                                    Giảm cân
                                </option>

                                <option value="MUSCLE_GAIN">
                                    Tăng cơ
                                </option>

                                <option value="MAINTAIN">
                                    Duy trì
                                </option>

                            </select>

                        </div>


                        <div class="mb-3">

                            <label asp-for="ExperienceLevel"
                                   class="form-label">

                                Trình độ

                            </label>

                            <select asp-for="ExperienceLevel"
                                    class="form-select">

                                <option value="">
                                    -- Chọn --
                                </option>

                                <option value="BEGINNER">
                                    Beginner
                                </option>

                                <option value="INTERMEDIATE">
                                    Intermediate
                                </option>

                                <option value="ADVANCED">
                                    Advanced
                                </option>

                            </select>

                        </div>


                        <div class="mb-3">

                            <label asp-for="ActivityLevel"
                                   class="form-label">

                                Mức vận động

                            </label>

                            <select asp-for="ActivityLevel"
                                    class="form-select">

                                <option value="">
                                    -- Chọn --
                                </option>

                                <option value="LOW">
                                    Low
                                </option>

                                <option value="MODERATE">
                                    Moderate
                                </option>

                                <option value="HIGH">
                                    High
                                </option>

                            </select>

                        </div>


                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="PreferredSessionsPerWeek"
                                       class="form-label">

                                    Số buổi / tuần

                                </label>

                                <input asp-for="PreferredSessionsPerWeek"
                                       class="form-control" />

                            </div>


                            <div class="col-md-6 mb-3">

                                <label asp-for="PreferredSessionMinutes"
                                       class="form-label">

                                    Phút / buổi

                                </label>

                                <input asp-for="PreferredSessionMinutes"
                                       class="form-control" />

                            </div>

                        </div>


                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Details"
                               asp-route-id="@Model.CustomerId"
                               class="btn btn-outline-secondary">

                                Hủy

                            </a>

                            <button type="submit"
                                    class="btn btn-dark">

                                Lưu thay đổi

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
