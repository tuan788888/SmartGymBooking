@model IEnumerable<SmartGymBooking.Models.Pt>

@{
    ViewData["Title"] = "Quản lý PT";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="page-title">
            Personal Trainers
        </h2>

        <p class="page-subtitle">
            Quản lý đội ngũ PT của SmartGym
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-smart-success">

        + Thêm PT

    </a>

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}


<div class="smart-card mb-4">

    <div class="card-body">

        <form method="get"
              class="row g-2">

            <div class="col-md-8">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Tìm tên, email, số điện thoại, chuyên môn..." />

            </div>

            <div class="col-md-auto">

                <button type="submit"
                        class="btn btn-smart-primary">

                    Tìm kiếm

                </button>

            </div>

            <div class="col-md-auto">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    Làm mới

                </a>

            </div>

        </form>

    </div>

</div>


<div class="row g-4">

    @if (!Model.Any())
    {
        <div class="col-12"><div class="smart-card"><div class="card-body text-center text-muted">Không tìm thấy PT.</div></div></div>
    }

    @foreach (var pt in Model)
    {
        <div class="col-xl-4 col-md-6">

            <div class="smart-card h-100">

                <div class="card-body">

                    <div class="d-flex gap-3">

                        @if (!string.IsNullOrWhiteSpace(pt.Avatar))
                        {
                            <img src="@pt.Avatar"
                                 class="avatar-circle"
                                 style="width: 80px; height: 80px;"
                                 alt="@pt.FullName" />
                        }
                        else
                        {
                            <div class="avatar-circle d-flex
                                        align-items-center
                                        justify-content-center"
                                 style="width:80px;height:80px;">

                                PT

                            </div>
                        }


                        <div class="flex-grow-1">

                            <h5 class="mb-1">
                                @pt.FullName
                            </h5>

                            <p class="text-muted mb-2">
                                @pt.Specialization
                            </p>


                            @if (pt.Status == "ACTIVE")
                            {
                                <span class="badge badge-soft-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-soft-danger">
                                    Inactive
                                </span>
                            }

                        </div>

                    </div>


                    <hr />


                    <p class="mb-2">

                        <strong>Kinh nghiệm:</strong>

                        @(pt.Experience.HasValue
                            ? $"{pt.Experience} năm"
                            : "Chưa cập nhật")

                    </p>


                    <p class="mb-2">

                        <strong>Điện thoại:</strong>

                        @(pt.Phone ?? "Chưa cập nhật")

                    </p>


                    <p class="mb-3">

                        <strong>Email:</strong>

                        @(pt.Email ?? "Chưa cập nhật")

                    </p>


                    <div class="d-flex flex-wrap gap-2">

                        <a asp-action="Details"
                           asp-route-id="@pt.Ptid"
                           class="btn btn-sm btn-outline-primary">

                            Chi tiết

                        </a>


                        <a asp-action="Edit"
                           asp-route-id="@pt.Ptid"
                           class="btn btn-sm btn-outline-warning">

                            Sửa

                        </a>


                        <form asp-action="ToggleStatus"
                              asp-route-id="@pt.Ptid"
                              method="post">

                            @Html.AntiForgeryToken()

                            @if (pt.Status == "ACTIVE")
                            {
                                <button type="submit"
                                        class="btn btn-sm
                                               btn-outline-secondary">

                                    Inactive

                                </button>
                            }
                            else
                            {
                                <button type="submit"
                                        class="btn btn-sm
                                               btn-outline-success">

                                    Active

                                </button>
                            }

                        </form>


                        <a asp-action="Delete"
                           asp-route-id="@pt.Ptid"
                           class="btn btn-sm btn-outline-danger">

                            Xóa

                        </a>

                    </div>

                </div>

            </div>

        </div>
    }

</div>
