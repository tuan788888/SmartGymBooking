@model SmartGymBooking.Models.Pt

@{
    ViewData["Title"] = "Chi tiết PT";
}

<div class="smart-card">

    <div class="card-body">

        <div class="row">

            <div class="col-md-3 text-center">

                @if (!string.IsNullOrWhiteSpace(Model.Avatar))
                {
                    <img src="@Model.Avatar"
                         class="rounded-circle"
                         style="width:180px;height:180px;object-fit:cover;"
                         alt="@Model.FullName" />
                }

            </div>


            <div class="col-md-9">

                <h2>
                    @Model.FullName
                </h2>

                <p class="text-muted">
                    @Model.Specialization
                </p>

                <p>
                    <strong>Kinh nghiệm:</strong>
                    @Model.Experience năm
                </p>

                <p>
                    <strong>Email:</strong>
                    @Model.Email
                </p>

                <p>
                    <strong>Điện thoại:</strong>
                    @Model.Phone
                </p>

                <p>
                    <strong>Trạng thái:</strong>
                    @Model.Status
                </p>

                <p>
                    <strong>Giới thiệu:</strong><br />
                    @Model.Description
                </p>


                <a asp-action="Edit"
                   asp-route-id="@Model.Ptid"
                   class="btn btn-warning">

                    Chỉnh sửa

                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    Quay lại

                </a>

            </div>

        </div>

    </div>

</div>
