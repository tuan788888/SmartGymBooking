@model SmartGymBooking.Models.Employee

@{
    ViewData["Title"] = "Xóa nhân viên";
}

<div class="container">

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="smart-card">

                <div class="card-body">

                    <h3 class="mb-3">
                        Xóa nhân viên
                    </h3>

                    <div class="alert alert-danger">
                        Hành động này sẽ xóa cả hồ sơ nhân viên
                        và tài khoản đăng nhập tương ứng.
                    </div>

                    <p>
                        <strong>Họ tên:</strong>
                        @Model.FullName
                    </p>

                    <p>
                        <strong>Email:</strong>
                        @Model.User.Email
                    </p>

                    <p>
                        <strong>Chức vụ:</strong>
                        @Model.Position
                    </p>

                    <form asp-action="DeleteConfirmed"
                          asp-route-id="@Model.EmployeeId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="d-flex gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">

                                Hủy

                            </a>

                            <button type="submit"
                                    class="btn btn-danger">

                                Xác nhận xóa

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
