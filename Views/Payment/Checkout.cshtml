@model SmartGymBooking.ViewModels.PaymentCheckoutViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment

@{
    ViewData["Title"] = "Thanh toán";
}

<div class="row justify-content-center">

    <div class="col-xl-9">

        <div class="row g-4">

            <!-- PAYMENT INFO -->
            <div class="col-lg-6">

                <div class="smart-card h-100">

                    <div class="card-body p-4">

                        <span class="badge bg-warning text-dark mb-3">
                            @Model.Status
                        </span>

                        <h2 class="mb-4">
                            Thanh toán gói tập
                        </h2>


                        <div class="mb-3">

                            <div class="text-muted">
                                Gói tập
                            </div>

                            <h5>
                                @Model.PackageName
                            </h5>

                        </div>


                        <div class="mb-3">

                            <div class="text-muted">
                                Thời hạn
                            </div>

                            <strong>
                                @Model.DurationDays ngày
                            </strong>

                        </div>


                        <div class="mb-3">

                            <div class="text-muted">
                                Personal Trainer
                            </div>

                            @if (Model.IncludesPT)
                            {
                                <span class="badge bg-success">
                                    Có PT
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Không bao gồm PT
                                </span>
                            }

                        </div>


                        <hr />


                        <div class="text-muted">
                            Tổng thanh toán
                        </div>

                        <h2 class="fw-bold">
                            @Model.Amount.ToString("N0") đ
                        </h2>


                        <div class="alert alert-warning mt-4">

                            Sau khi chuyển khoản,
                            vui lòng chờ nhân viên xác nhận.

                        </div>

                    </div>

                </div>

            </div>


            <!-- QR -->
            <div class="col-lg-6">

                <div class="smart-card h-100">

                    <div class="card-body p-4 text-center">

                        <h4 class="mb-3">
                            Quét mã QR
                        </h4>

                        @if (Model.Status == "PENDING")
                        {
                        @if (System.IO.File.Exists(System.IO.Path.Combine(Environment.WebRootPath, "images", "payment", "bank-qr.png")))
                        {
                        <img src="@Model.QrImageUrl"
                             alt="QR thanh toán"
                             class="img-fluid rounded"
                             style="max-width:300px;" />
                        }
                        <dl class="mt-3">
                            <dt>Ngân hàng</dt><dd>Vietcombank</dd>
                            <dt>Chủ tài khoản</dt><dd>LE ANH TUAN</dd>
                            <dt>Số tài khoản</dt><dd>1041192956</dd>
                        </dl>
                        <p>Nhập số tiền @Model.Amount.ToString("N0") đ và nội dung bên dưới khi chuyển khoản.</p>


                        <div class="mt-4">

                            <div class="text-muted">
                                Nội dung chuyển khoản
                            </div>

                            <div class="border rounded p-3 mt-2">

                                <strong class="fs-5">
                                    @Model.PaymentCode
                                </strong>

                            </div>

                        </div>


                        <p class="text-danger mt-3 mb-0">

                            Vui lòng nhập đúng nội dung
                            chuyển khoản.

                        </p>
                        }
                        else
                        {
                            <p>Giao dịch này đã kết thúc. Không chuyển khoản cho giao dịch này.</p>
                        }

                    </div>

                </div>

            </div>

        </div>


        <div class="text-center mt-4">

            <a asp-action="History"
               class="btn btn-outline-dark">

                Xem lịch sử thanh toán

            </a>

        </div>

    </div>

</div>
